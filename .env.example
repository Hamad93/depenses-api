# Local development (SQLite file, no auth token needed)
DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=

# Production (Turso / libSQL remote database)
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso-auth-token>"

# Cloudflare Pages URL allowed to call this API via CORS
# FRONTEND_URL="https://depenses-web.pages.dev"

# Port the server listens on (set automatically by most hosts, e.g. Render)
# PORT=3000
